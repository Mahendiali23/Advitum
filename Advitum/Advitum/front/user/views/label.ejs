    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const mainNavbar = document.querySelector('.nav-anchor');
            const menuToggle = document.querySelector('#menuToggle');
            const navLinkItems = document.querySelectorAll('.nav-link-item');

            // 1. Scroll State Matrix Watcher
            const syncScrollState = () => {
                if (window.scrollY > 20) {
                    mainNavbar.classList.add('scrolled');
                } else {
                    mainNavbar.classList.remove('scrolled');
                }
            };
            window.addEventListener('scroll', syncScrollState, { passive: true });
            syncScrollState();

            // 2. Mobile Dashboard Drawer Viewport Control
            if (menuToggle && mainNavbar) {
                menuToggle.addEventListener('click', (e) => {
                    e.preventDefault();
                    mainNavbar.classList.toggle('open-viewport');
                    
                    if (mainNavbar.classList.contains('open-viewport')) {
                        document.body.style.overflow = 'hidden';
                        menuToggle.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    } else {
                        document.body.style.overflow = '';
                        menuToggle.innerHTML = '<i class="fa-solid fa-bars-staggered"></i>';
                    }
                });
            }

            // 3. Mobile Sub-link Accordion Engine
            navLinkItems.forEach(item => {
                item.addEventListener('click', (e) => {
                    if (window.innerWidth <= 991) {
                        const hasDropdown = item.parentElement.querySelector('.dropdown-card');
                        if (hasDropdown) {
                            e.preventDefault();
                            const activeNode = item.parentElement;
                            
                            document.querySelectorAll('.nav-item').forEach(node => {
                                if(node !== activeNode) node.classList.remove('mobile-active');
                            });

                            activeNode.classList.toggle('mobile-active');
                        }
                    }
                });
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
    const catalogModal = document.getElementById('catalogDetailsModal');
    const closeModalBtn = document.getElementById('closeCatalogModalBtn');
    
    // Select Elements Inside the Modal Layout Blueprint
    const mImg = document.getElementById('modalImage');
    const mBadge = document.getElementById('modalBadge');
    const mCategory = document.getElementById('modalCategory');
    const mTitle = document.getElementById('modalTitle');
    const mPrice = document.getElementById('modalPrice');
    const mDesc = document.getElementById('modalDescription');

    // Attach Click Event Listeners to all item cards natively
    document.getElementById('productsCatalogGridMatrix').addEventListener('click', (e) => {
        const cardNode = e.target.closest('.product-catalog-card');
        if (!cardNode) return;

        // Fetch RAW un-mutated details out of target element attributes
        const title = cardNode.getAttribute('data-item-raw-name');
        const category = cardNode.getAttribute('data-item-raw-category');
        const price = cardNode.getAttribute('data-item-raw-price');
        const imgUrl = cardNode.getAttribute('data-item-image');
        const badge = cardNode.getAttribute('data-item-badge');
        const description = cardNode.getAttribute('data-item-description');

        // Render fields out inside corresponding structural nodes
        mImg.src = imgUrl;
        mImg.alt = title;
        mBadge.textContent = badge;
        mCategory.textContent = category;
        mTitle.textContent = title;
        mPrice.textContent = `$${price}`;
        mDesc.textContent = description;

        // Animate visibility smoothly
        catalogModal.classList.add('modal-visible');
        document.body.style.overflow = 'hidden'; // Lock background scrolling
    });

    // Close Modal Callback Handlers
    const closeCatalogModalView = () => {
        catalogModal.classList.remove('modal-visible');
        document.body.style.overflow = '';
    };

    closeModalBtn.addEventListener('click', closeCatalogModalView);
    
    // Close on clicking outside the modal window boundary
    catalogModal.addEventListener('click', (e) => {
        if (e.target === catalogModal) closeCatalogModalView();
    });

    // Close on hitting Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && catalogModal.classList.contains('modal-visible')) {
            closeCatalogModalView();
        }
    });
});
    </script>
