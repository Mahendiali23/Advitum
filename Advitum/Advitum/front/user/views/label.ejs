            <input type="text" id="catalogSearchInput" placeholder="Search across current collections, dynamic specifications, and parts...">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
    </section>

    <main class="catalog-main-wrapper">
        <div class="catalog-layout-container">
            
            <aside class="filter-sidebar">
                <div class="sidebar-sticky-wrapper">
                    <div class="sidebar-section-title">
                        <i class="fa-solid fa-tags"></i>
                        <span>Product Categories</span>
                    </div>
                    <div class="category-nodes-list" id="categorySelectionWrapper">
                        
                        <button class="category-item active-filter" data-category-id="all">
                            <span>All Collections</span>
                            <span class="category-count" id="badge-count-all">0</span>
                        </button>

                        <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                            <% categories.forEach(function(cat) { %>
                                <button class="category-item" data-category-id="<%= cat._id %>">
                                    <span><%= cat.name %></span>
                                    <span class="category-count" id="badge-count-<%= cat._id %>">0</span>
                                </button>
                            <% }); %>
                        <% } %>

                    </div>
                </div>
            </aside>

            <section class="catalog-content">
                
                <div class="catalog-results-header">
                    <div class="results-counter">
                        Displaying <span id="visibleCardsCount">0</span> of <span id="totalCardsCount">0</span> matched dynamic records
                    </div>
                    <div class="sort-select-wrapper">
                        <label for="catalogSortSelect">Sort Layout Matrix</label>
                        <select id="catalogSortSelect">
                            <option value="default">Alpha Collection: A-Z</option>
                            <option value="price-asc">Price Metric: Low to High</option>
                            <option value="price-desc">Price Metric: High to Low</option>
                        </select>
                    </div>
                </div>

                <div class="products-grid-matrix" id="productsCatalogGridMatrix">
                    
                    <% if (typeof items !== 'undefined' && items && items.length > 0) { %>
                        <% items.forEach(function(item) { %>
                            
                            <article class="product-catalog-card" 
                                     data-item-name="<%= item.name ? item.name.toLowerCase() : '' %>"
                                     data-item-category="<%= (item.category && item.category._id) ? item.category._id : '' %>"
                                     data-item-price="<%= item.price ? item.price : 0 %>"
                                     data-item-raw-name="<%= item.name ? item.name : '' %>"
                                     data-item-raw-category="<%= (item.category && item.category.name) ? item.category.name : 'Unassigned' %>"
                                     data-item-image="<%= (typeof item.image !== 'undefined' && item.image) ? item.image : 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80' %>"
                                     data-item-badge="<%= typeof item.badge !== 'undefined' && item.badge ? item.badge : 'In Stock' %>"
                                     data-item-raw-price="<%= (typeof item.price === 'number') ? item.price.toFixed(2) : item.price %>"
                                     data-item-description="<%= item.description ? item.description : 'No comprehensive description file provided for this dynamic product classification.' %>">
                                
                                <div class="card-media-canvas">
                                    <span class="form-factor-badge">
                                        <%= typeof item.badge !== 'undefined' && item.badge ? item.badge : 'In Stock' %>
                                    </span>
                                    <img src="<%= (typeof item.image !== 'undefined' && item.image) ? item.image : 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80' %>" 
                                         alt="<%= item.name %>" 
                                         loading="lazy">
                                </div>

                                <div class="card-meta-body">
                                    <span class="product-category-label">
                                        <%= (item.category && item.category.name) ? item.category.name : 'Unassigned' %>
                                    </span>
                                    <h3><%= item.name %></h3>
                                    <div class="product-price-tag">
                                        $<%= (typeof item.price === 'number') ? item.price.toFixed(2) : item.price %>
                                    </div>
                                    <p class="truncate-text"><%= item.description ? item.description : 'No comprehensive description file provided for this dynamic product classification.' %></p>
                                    <button class="btn-action-link">
                                        <i class="fa-solid fa-eye"></i>
                                        <span>View Details</span>
                                    </button>
                                </div>
                            </article>

                        <% }); %>
                    <% } %>

                </div>

                <div class="zero-state-container" id="zeroStateContainer">
                    <i class="fa-solid fa-boxes-packing"></i>
                    <h4>No Dynamic Matches Found</h4>
                    <p>The system parameters cannot locate item cards running matches with your active search input strings or category filter conditions.</p>
                    <button class="btn-reset-filters" id="btnResetFilters">
                        <i class="fa-solid fa-arrow-rotate-left"></i>
                        <span>Reinitialize Filters</span>
                    </button>
                </div>

            </section>
        </div>
    </main>

    <div class="catalog-modal-overlay" id="catalogDetailsModal">
        <div class="catalog-modal-window">
