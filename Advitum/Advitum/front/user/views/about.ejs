    <style>
         :root {
            --primary: #044E4A;
            --primary-light: #0B6B65;
            --primary-dark: #033E3B;
            --accent: #10B981;
            --accent-light: #D1FAE5;
            --dark: #1E293B;
            --text: #475569;
            --text-muted: #94A3B8;
            --bg-light: #F8FAFC;
            --bg-tint: #F4FAF9;
            --white: #FFFFFF;
            --border: #E2E8F0;
            
            --font-main: 'Plus Jakarta Sans', sans-serif;
            --font-heading: 'Poppins', sans-serif;
            --shadow-sm: 0 2px 4px rgba(4, 78, 74, 0.05);
            --shadow-md: 0 10px 25px rgba(4, 78, 74, 0.08);
            --shadow-lg: 0 20px 40px rgba(4, 78, 74, 0.12);
            --radius-pill: 50px;
            --radius-lg: 24px;
            --radius-sm: 10px;
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        *, *::before, *::after { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }
        
        html { 
            scroll-behavior: smooth; 
        }
        
        body { 
            font-family: var(--font-main); 
            color: var(--text); 
            background-color: var(--white); 
            line-height: 1.6; 
            overflow-x: hidden; 
        }
        
        h1, h2, h3, h4 { 
            font-family: var(--font-heading); 
            color: var(--dark); 
        }
        
        img { 
            max-width: 100%; 
            height: auto; 
            display: block; 
        }
        
        a { 
            text-decoration: none; 
            color: inherit; 
            transition: var(--transition); 
        }

        /* Global Layout Components */
        .wrapper { 
            max-width: 1240px; 
            margin: 0 auto; 
            padding: 0 24px; 
            width: 100%; 
        }
        
        .section-space { 
            padding: 100px 0; 
        }
        
        .section-space-alt { 
            padding: 100px 0; 
            background-color: var(--bg-tint); 
        }

        .section-badge { 
            display: inline-block; 
            padding: 6px 16px; 
            background-color: var(--accent-light); 
            color: var(--primary-dark); 
            border-radius: var(--radius-pill); 
            font-size: 13px; 
            font-weight: 700; 
            text-transform: uppercase; 
            margin-bottom: 16px; 
            letter-spacing: 0.5px; 
        }

        /* Buttons */
        .btn-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 32px;
            font-weight: 600;
            border-radius: var(--radius-pill);
            font-size: 0.95rem;
            cursor: pointer;
            border: none;
            transition: var(--transition);
            gap: 8px;
        }

        .btn-primary {
            background-color: var(--primary);
            color: var(--white);
        }

        .btn-primary:hover {
            background-color: var(--primary-light);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(4, 78, 74, 0.2);
        }

 /* ==========================================================================
   2. HEADER & NAVIGATION ARCHITECTURE
   ========================================================================== */
:root {
    /* Safe fallback tokens if your global css template variables are not parsed */
    --white: #ffffff;
    --transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}
.nav-anchor {
    position: fixed;
    top: 20px; 
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 48px);
    max-width: 1500px;
    height: 100px;
    z-index: 1000;
    background-color: white; 
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px; 
    padding: 0 36px;
    box-shadow: 0 12px 30px rgba(4, 78, 74, 0.15);
    transition: var(--transition);
    backdrop-filter: blur(8px);
    border: .5px solid #e2e8f0; 
    border-left: 7px solid var(--primary, #0f615d); 
    border-right: 7px solid var(--primary, #0f615d);
    -webkit-backdrop-filter: blur(8px);
}

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    margin: 0 auto;
}

/* Default Inverted Colors (Resting State) */
.nav-anchor .brand-logo h2 { color: #044E4A;}
.nav-anchor .brand-logo span { color: #64748B; }
.nav-anchor .nav-link-item { color: #0F172A; }
.nav-anchor .mobile-hamburger { color: #0F172A; }


/* Typography & Brand Identity */
.brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    justify-content: center;
}

.brand-logo h2 {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    line-height: 1;
    letter-spacing: -0.5px;
}

.brand-logo span {
    font-size: 0.5rem;
    letter-spacing: 2px;
    font-weight: 700;
    display: block;
    margin-top: 5px;
    text-transform: uppercase;
    line-height: 1;
}

/* Nav Linksets */
.nav-linkset {
    display: flex;
    align-items: center;
    gap: 5px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-link-item {
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    position: relative;
    padding: 8px 16px;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
}

.nav-anchor .nav-link-item:hover, 
.nav-anchor .nav-link-item.active-node {
     color: #044E4A !important;
    background-color: rgba(4, 78, 74, 0.08);
}

.badge-new {
    background: #ef4444;
    color: white;
    font-size: 0.5rem;
    padding: 1px 5px;
    border-radius: 4px;
    margin-left: 6px;
    font-weight: 700;
    display: inline-block;
}

.mobile-hamburger {
    display: none;
    font-size: 1.35rem; 
    cursor: pointer;
    background: transparent;
    border: none;
    outline: none;
    padding: 6px;
    align-items: center;
    justify-content: center;
}

/* ==========================================================================
   HIGH-PERFORMANCE SCROLLED STATE (Desktop & Mobile Base)
   ========================================================================== */
.nav-anchor.scrolled {
    top: 0;
    left: 50%;
    transform: translateX(-50%);

    width: 100%;
    max-width: 100%;
    height: 80px;

    border-radius: 0;
    background: rgba(255,255,255,0.9);
    border-bottom: 1px solid rgba(226,232,240,0.8);
    box-shadow: 0 4px 20px rgba(15,23,42,0.06);
    border-bottom-left-radius:12px ;
    border-bottom-right-radius:12px ;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}
/* Color Realignment for Scrolled Layout */
.nav-anchor.scrolled .brand-logo h2 { color: #044E4A; } 
.nav-anchor.scrolled .brand-logo span { color: #64748B; } 
.nav-anchor.scrolled .nav-link-item { color: #0F172A; }   
.nav-anchor.scrolled .mobile-hamburger { color: #0F172A; }

.nav-anchor.scrolled .nav-link-item:hover, 
.nav-anchor.scrolled .nav-link-item.active-node {
    color: #044E4A !important;
    background-color: rgba(4, 78, 74, 0.08);
}

/* ==========================================================================
   MOBILE RESPONSIVE RE-ENGINEERING (Flawless Axis Alignment)
   ========================================================================== */
@media (max-width: 991px) {
    .nav-anchor {
        height: 80px; /* Give mobile a consistent clean baseline height from the start */
        padding: 0 24px;
        width: calc(100% - 32px);
        top: 16px;
    }

    .nav-anchor.scrolled {
        top: 0;
        width: 100%;
        height: 70px; /* Crisp line when scrolling */
    }

    .mobile-hamburger {
        display: flex; /* Enforces horizontal structural center alignment for icons */
        width: 40px;
        height: 40px;
    }

    /* Fixed alignment hack: Keep cross and bar center-aligned inside the bounding box */
    .mobile-hamburger i {
        display: block;
        line-height: 1;
        width: auto;
        height: auto;
    }

    /* Full screen mobile drawer */
    .nav-linkset {
        position: fixed;
        left: 0;
        width: 100%;
        height: 0; 
        background-color: #044E4A;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        padding-top: 0;
        gap: 8px;
        overflow-y: auto;
        transition: var(--transition);
        z-index: 999;
    }

    /* Dropdown placement matching navigation heights perfectly */
    .nav-anchor { top: 16px; }
    .nav-anchor .nav-linkset { top: 96px; } /* 80px (nav height) + 16px (top offset) */
    .nav-anchor.scrolled .nav-linkset { top: 70px; }

    /* Open State Configuration */
    .nav-anchor.open-viewport .nav-linkset {
        height: calc(100vh - 96px);
        padding: 32px 0;
    }
    
    .nav-anchor.scrolled.open-viewport .nav-linkset {
        height: calc(100vh - 70px);
    }

    .nav-link-item {
        width: 88%;
        justify-content: center;
        font-size: 15px;
        padding: 16px 0;
        color: rgba(255, 255, 255, 0.9) !important;
        border-radius: 12px;
        background-color: rgba(255, 255, 255, 0.03);
    }

    .nav-link-item:hover,
    .nav-link-item.active-node {
        background-color: rgba(230, 226, 226, 0.1) !important;
        color: var(--white) !important;
    }

    /* Force background preservation when mobile menu layout is active */
    .nav-anchor.open-viewport,
    .nav-anchor.scrolled.open-viewport {
        background-color: #044E4A !important;
        border-radius: 16px !important; /* Keep a nice matching frame style when active open */
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
    
    .nav-anchor.scrolled.open-viewport {
        top: 0 !important;
        width: 100% !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-right: none !important;
        border-top: none !important;
    }

    .nav-anchor.open-viewport .brand-logo h2,
    .nav-anchor.scrolled.open-viewport .brand-logo h2 { color: var(--white) !important; }
    
    .nav-anchor.open-viewport .brand-logo span,
    .nav-anchor.scrolled.open-viewport .brand-logo span { color: rgba(255, 255, 255, 0.6) !important; }
    
    .nav-anchor.open-viewport .mobile-hamburger,
    .nav-anchor.scrolled.open-viewport .mobile-hamburger { color: var(--white) !important; }
}

      /* HERO */

.interior-hero{
    padding:160px 0 80px;
    background:linear-gradient(
        135deg,
        #ffffff 0%,
        #f7fbfb 100%
    );
    border-bottom:1px solid #edf2f7;
}

.interior-hero h1{
    font-size:46px;
    line-height:1.2;
    font-weight:700;
    margin-bottom:16px;
    color:var(--primary-dark);
}

.interior-hero p{
    max-width:700px;
    font-size:16px;
    line-height:1.8;
    color:var(--text-muted);
}

/* SECTIONS */

.section-space,
.section-space-alt{
    padding:90px 0;
}

/* SECTION HEADINGS */

.about-text h2,
.section-space h2,
.section-space-alt h2{
    font-size:32px;
    line-height:1.3;
    margin-bottom:18px;
    color:var(--primary-dark);
}

/* CONTENT */

.about-text p,
.vision-mission-card p,
.value-node-card p{
    font-size:15px;
    line-height:1.8;
}

/* IMAGE */

.about-image img{
    height:460px;
    border-radius:20px;
    box-shadow:0 12px 30px rgba(4,78,74,.08);
}

/* GRIDS */

.split-layout-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.dual-column-matrix{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:24px;
}

.hexagonal-values-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

/* CARDS */

.vision-mission-card,
.value-node-card{
    background:#fff;
    border:1px solid #e8efef;
    border-radius:18px;
    padding:30px;
    transition:.3s ease;
}

.vision-mission-card:hover,
.value-node-card:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 25px rgba(4,78,74,.06);
}

.vision-mission-card h3{
    font-size:22px;
    margin-bottom:18px;
}

.value-node-card h4{
    font-size:18px;
    margin-bottom:10px;
}

/* CTA */

.closing-banner-strip{
    padding:65px 50px;
    border-radius:24px;
    background:var(--primary-dark);
}

.closing-banner-strip h2{
    font-size:34px;
    margin-bottom:14px;
    color:#fff;
}

.closing-banner-strip p{
    font-size:15px;
    max-width:700px;
    margin:0 auto 24px;
}

/* MOBILE */

@media(max-width:992px){

    .split-layout-grid,
    .dual-column-matrix{
        grid-template-columns:1fr;
        gap:35px;
    }

    .hexagonal-values-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .about-image img{
        height:350px;
    }

    .interior-hero h1{
        font-size:38px;
    }
}

@media(max-width:768px){

    .section-space,
    .section-space-alt{
        padding:70px 0;
    }

    .hexagonal-values-grid{
        grid-template-columns:1fr;
    }

    .interior-hero{
        padding:130px 0 60px;
    }

    .interior-hero h1{
        font-size:30px;
    }

    .about-text h2,
    .section-space h2,
    .section-space-alt h2{
        font-size:26px;
    }

    .vision-mission-card,
    .value-node-card{
        padding:24px;
    }

    .closing-banner-strip{
        padding:45px 25px;
    }

    .closing-banner-strip h2{
        font-size:28px;
    }
}


