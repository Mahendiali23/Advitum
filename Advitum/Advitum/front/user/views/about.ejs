<script>
    document.addEventListener("DOMContentLoaded", () => {
    const mainNavbar = document.querySelector('.nav-anchor');
    const menuToggle = document.querySelector('.mobile-hamburger');
    const navLinks = document.querySelectorAll('.nav-link-item');

    // 1. Core Scroll Watcher Engine
    const syncScrollState = () => {
        if (window.scrollY > 20) {
            mainNavbar.classList.add('scrolled');
        } else {
            mainNavbar.classList.remove('scrolled');
        }
    };

    syncScrollState();
    window.addEventListener('scroll', syncScrollState, { passive: true });

    // 2. Mobile Drawer Event Management
    if (menuToggle && mainNavbar) {
        menuToggle.addEventListener('click', (e) => {
            e.preventDefault();
            mainNavbar.classList.toggle('open-viewport');
            
            if (mainNavbar.classList.contains('open-viewport')) {
                document.body.style.overflow = 'hidden'; // Protect background from dragging
                menuToggle.innerHTML = '<i class="fa-solid fa-xmark"></i>'; // Sets close icon cleanly
            } else {
                document.body.style.overflow = '';
                menuToggle.innerHTML = '<i class="fa-solid fa-bars-staggered"></i>'; // Restores hamburger bars
            }
        });

        // Auto-collapse when user selects an internal destination anchor target
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (mainNavbar.classList.contains('open-viewport')) {
                    mainNavbar.classList.remove('open-viewport');
                    document.body.style.overflow = '';
                    menuToggle.innerHTML = '<i class="fa-solid fa-bars-staggered"></i>';
                }
            });
        });
    }
});
</script>

