            width: 30px;
            height: 2px;
            background-color: var(--accent);
        }

        .footer-link-group ul {
            list-style: none;
        }

        .footer-link-group ul li {
            margin-bottom: 12px;
        }

        .footer-link-group ul li a {
            color: #94A3B8;
        }

        .footer-link-group ul li a:hover {
            color: var(--white);
