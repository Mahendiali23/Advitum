        }

        .footer-address-nodes li {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            line-height: 1.5;
            margin-bottom: 16px !important;
        }

        .footer-address-nodes li i {
            color: var(--accent);
            font-size: 1.1rem;
            margin-top: 3px;
        }

        .footer-signature-row {
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding-top: 30px;
