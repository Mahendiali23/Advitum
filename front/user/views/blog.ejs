    opacity: 0.12;
  }
  .category-card:hover::before {
    top: 35px;
    height: 55px;
    width: 5px;
    background: linear-gradient(180deg, var(--teal-neon-glow) 0%, var(--accent) 100%);
  }
  .category-card:hover .category-icon-wrapper {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: var(--white);
    border-color: transparent;
    transform: scale(1.08) rotate(-4deg);
    box-shadow: 0 8px 22px rgba(4, 78, 74, 0.2);
  }
  .category-card:hover h4 {
    color: var(--primary-light);
  }

  /* Insights Hub Cards Hover */
  .matrix-card:hover {
    transform: translate3d(0, -10px, 0);
    box-shadow: var(--shadow-hover);
    border-color: rgba(4, 78, 74, 0.08);
  }
  .matrix-card:hover::before {
    width: 100%;
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    border-radius: 0;
  }
  .matrix-card:hover .icon-frame {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: var(--white);
    border-color: transparent;
    transform: scale(1.08) rotate(-4deg);
    box-shadow: 0 8px 22px rgba(4, 78, 74, 0.2);
  }
  .matrix-card:hover .card-body-content h3 {
    color: var(--primary-light);
  }
  .matrix-card:hover .node-action-link {
    color: var(--teal-neon-glow);
  }
  .matrix-card:hover .node-action-link i {
    transform: translate3d(5px, 0, 0);
    color: var(--accent);
  }
}

