  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6px; 
  height: 100%;
  background: linear-gradient(180deg, var(--emerald-neon) 0%, var(--emerald-main) 100%);
  border-radius: 20px 0 0 20px;
  transition: all 0.5s cubic-bezier(0.2, 1, 0.2, 1);
  z-index: 2;
}

/* Floating Interlocking Squircle Stamp */
.cert-stamp {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 52px;
  height: 52px;
  border-radius: 14px; 
  background: rgba(2, 44, 34, 0.04);
  border: 1px solid rgba(4, 120, 87, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.4s cubic-bezier(0.2, 1, 0.2, 1);
}

.cert-stamp .stamp-top {
  font-size: 0.52rem;
  font-weight: 800;
  color: var(--emerald-main);
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.cert-stamp i {
  font-size: 0.85rem;
  color: var(--emerald-deep);
  margin-top: 3px;
}

/* Minimalist Inner Frame for Logos */
.cert-img-frame {
  width: 84px; 
  height: 84px;
  background: var(--slate-bg-tint);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  border: 1px solid rgba(0, 0, 0, 0.01);
  transition: all 0.4s ease;
}

.cert-img-element {
  width: 65%;
  height: 65%;
  object-fit: contain;
  mix-blend-mode: multiply; /* Fixes white box issue completely */
  transition: transform 0.5s cubic-bezier(0.2, 1, 0.2, 1);
}

/* Metadata Typography Grid Alignment */
.cert-card-meta {
  text-align: left; 
  width: 100%;
}

.cert-card-meta h4 {
  font-family: sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
