  line-height: 1.4;
  display: block;
}

/* Premium Linear Space Separator */
.quality-divider {
  border: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(4, 120, 87, 0.1) 50%, transparent);
  margin: 70px 0;
