    <!-- Slider Track -->
    <div class="hero-slider-track">
        <div class="hero-slide"><img src="01.png" alt="Medical Solutions 1"></div>
        <div class="hero-slide"><img src="02.png" alt="Medical Solutions 2"></div>
        <div class="hero-slide"><img src="03.png" alt="Medical Solutions 3"></div>
        <div class="hero-slide"><img src="04.png" alt="Medical Solutions 4"></div>
    </div>

    <!-- Navigation Arrows -->
    <button class="slide-arrow prev-arrow" aria-label="Previous Slide">&#10094;</button>
    <button class="slide-arrow next-arrow" aria-label="Next Slide">&#10095;</button>

    <!-- Capsule Dots Overlay -->
    <div class="slide-dots-capsule">
        <span class="dot active"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    const track = document.querySelector('.hero-slider-track');
    const slides = Array.from(track.children);
    const nextBtn = document.querySelector('.next-arrow');
    const prevBtn = document.querySelector('.prev-arrow');
    const dots = document.querySelectorAll('.dot');

    let currentIndex = 0;

    function updateSlider(index) {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach(dot => dot.classList.remove('active'));
      dots[index].classList.add('active');
      currentIndex = index;
    }

    nextBtn.addEventListener('click', () => {
      let index = (currentIndex + 1) % slides.length;
      updateSlider(index);
    });

    prevBtn.addEventListener('click', () => {
      let index = (currentIndex - 1 + slides.length) % slides.length;
      updateSlider(index);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        updateSlider(index);
      });
    });
  </script>

