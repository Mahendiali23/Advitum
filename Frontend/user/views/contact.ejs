function showCreativeToast(message) {
    const container = document.getElementById('toastContainer');
    if (!container) return; // Prevent breaking code if missing anchor execution
    
    const toast = document.createElement('div');
    toast.className = 'creative-toast-node';
    toast.innerHTML = `
        <div class="toast-indicator-pill"></div>
        <i class="fa-solid fa-circle-check toast-icon-check"></i>
        <div class="toast-message-body">${message}</div>
    `;
    container.appendChild(toast);
    
    setTimeout(() => { toast.classList.add('is-visible'); }, 50);
    setTimeout(() => {
        toast.classList.remove('is-visible');
        toast.classList.add('is-fading');
        setTimeout(() => { toast.remove(); }, 400);
    }, 3500);
}
        }

