    border: 1px solid var(--advitum-border);
    border-radius: var(--advitum-radius-md);
    padding: 16px 20px;
    text-decoration: none;
    box-shadow: var(--advitum-shadow-card);
    transition: var(--advitum-transition);
}

.channel-icon-box {
    width: 38px;
    height: 38px;
    background-color: #F8FAFC;
    color: var(--advitum-primary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    border: 1px solid rgba(226, 232, 240, 0.6);
    transition: var(--advitum-transition);
    flex-shrink: 0;
}

.channel-icon-box.whatsapp-bg { color: #23C55E; background-color: #F0FDF4; }
.channel-icon-box.email-bg { color: #0284c7; background-color: #F0F9FF; }

.channel-data { 
    display: flex; 
    flex-direction: column; 
    gap: 2px; 
}

.channel-data span { 
    font-family: var(--advitum-font-main); 
    font-size: 0.65rem; 
    font-weight: 600; 
    color: var(--advitum-text-muted); 
    text-transform: uppercase; 
    letter-spacing: 0.5px;
}

.channel-data strong { 
    font-family: var(--advitum-font-main); 
    font-size: 1.02rem; 
    font-weight: 700;
    color: var(--advitum-dark); 
    letter-spacing: -0.01em;
    word-break: break-all;
}

/* Social Nodes Hub Section */
.social-footer-hub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 32px;
    gap: 16px;
}

.social-row-strip {
    display: flex;
    align-items: center;
    gap: 10px;
}

.social-circle-node {
    width: 34px;
    height: 34px;
    background-color: var(--advitum-white);
    border: 1px solid var(--advitum-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--advitum-text-muted);
    font-size: 0.95rem;
    text-decoration: none;
