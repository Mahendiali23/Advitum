    font-weight: 500;
}

.location-brief-indicator i {
    color: var(--advitum-accent);
    font-size: 0.9rem;
}

/* ==========================================================================
   4. Right Column Form Design (Sleek Compact Card Dashboard Theme)
   ========================================================================== */
.contact-form-panel {
    background: var(--advitum-white);
