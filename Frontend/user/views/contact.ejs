    .channel-data strong { font-size: 0.92rem; }
    .social-footer-hub { flex-direction: column; align-items: flex-start; gap: 14px; }
    .toast-container-anchor { left: 16px; right: 16px; bottom: 16px; } 
    .creative-toast-node { min-width: 100%; } 
}

