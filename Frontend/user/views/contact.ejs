    font-size: 0.78rem; 
    color: var(--advitum-text-muted); 
    line-height: 1.4; 
}

.inquiry-form-wrapper { 
    display: grid; 
    grid-template-columns: 1fr; 
    gap: 16px; 
}

.form-field-group { 
    display: flex; 
    flex-direction: column; 
    gap: 6px; 
}

.form-field-group label { 
    font-family: var(--advitum-font-main); 
    font-size: 0.72rem; 
    font-weight: 700; 
    color: var(--advitum-dark); 
    letter-spacing: 0.3px;
    text-transform: uppercase;
}

/* Compact Inputs & Clean Placeholders */
.input-relative-container, 
.textarea-relative-container { 
    position: relative; 
    display: flex; 
    align-items: center; 
    width: 100%; 
}

.field-icon, 
.textarea-icon { 
    position: absolute; 
    left: 16px; 
    color: #A1A1AA; 
    font-size: 0.95rem; 
    transition: color 0.2s ease; 
    pointer-events: none; 
    z-index: 2; 
}

.textarea-icon { top: 14px; }

.input-relative-container input, 
.textarea-relative-container textarea {
    width: 100%; 
    background-color: #F8FAFC; 
    border: 1px solid #E2E8F0; 
    border-radius: var(--advitum-radius-md);
    font-family: var(--advitum-font-main); 
    font-size: 0.88rem; 
    font-weight: 500;
    color: var(--advitum-dark); 
    outline: none; 
    transition: var(--advitum-transition);
}

.input-relative-container input { padding: 12px 14px 12px 42px; }
.textarea-relative-container textarea { padding: 12px 14px 12px 42px; resize: none; min-height: 90px; line-height: 1.5; }

/* Micro Placeholder Custom Adjustments */
.input-relative-container input::placeholder,
.textarea-relative-container textarea::placeholder {
    color: var(--advitum-placeholder);
    font-weight: 400;
    font-size: 0.82rem;
}

/* Input Focus States */
.input-relative-container input:focus, 
.textarea-relative-container textarea:focus {
    background-color: var(--advitum-white); 
    border-color: var(--advitum-primary);
    box-shadow: 0 0 0 3px rgba(4, 78, 74, 0.08);
}

.input-relative-container input:focus ~ .field-icon, 
.textarea-relative-container textarea:focus ~ .textarea-icon { 
    color: var(--advitum-primary); 
}

/* Micro Action Button */
.submit-action-btn {
    position: relative; 
    background-color: var(--advitum-primary); 
    color: var(--advitum-white); 
    border: none; 
    border-radius: var(--advitum-radius-md);
    padding: 14px 24px; 
    font-family: var(--advitum-font-main); 
    font-size: 0.85rem; 
    font-weight: 700; 
    letter-spacing: 0.5px; 
    cursor: pointer;
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    gap: 8px; 
    transition: var(--advitum-transition); 
    margin-top: 6px; 
    width: 100%;
}

/* Desktop Hover States */
@media (hover: hover) {
    .channel-card:hover { 
        transform: translateY(-2px);
        box-shadow: var(--advitum-shadow-card-hover);
        border-color: transparent;
    }
    .channel-card:hover .channel-icon-box {
        background-color: var(--advitum-primary);
        color: var(--advitum-white);
    }
    .channel-card:hover .channel-icon-box.whatsapp-bg { background-color: #23C55E; color: #fff; }
    .channel-card:hover .channel-icon-box.email-bg { background-color: #0284c7; color: #fff; }

    .social-circle-node:hover {
        color: var(--advitum-white);
        transform: translateY(-2px);
    }
    .social-circle-node.linkedin-color:hover { background-color: #0077B5; border-color: #0077B5; }
    .social-circle-node.instagram-color:hover { background-color: #E1306C; border-color: #E1306C; }

    .submit-action-btn:hover { 
        background-color: var(--advitum-primary-light);
        box-shadow: 0 4px 12px rgba(4, 78, 74, 0.2);
    }
}

/* ==========================================================================
   5. Feedback Toast Notifications Engine
   ========================================================================== */
.toast-container-anchor { 
    position: fixed; 
    bottom: 24px; 
    right: 24px; 
    display: flex; 
    flex-direction: column; 
    gap: 8px; 
    z-index: 99999; 
    pointer-events: none; 
}

.creative-toast-node {
    background: #022F2D;
    padding: 14px 20px; 
    border-radius: 10px; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.15); 
    display: flex; 
    align-items: center; 
    gap: 12px;
    pointer-events: auto; 
    min-width: 280px; 
    transform: translate3d(30px, 0, 0); 
    opacity: 0; 
    transition: var(--advitum-transition);
}

.creative-toast-node.is-visible { opacity: 1; transform: translate3d(0, 0, 0); }
.creative-toast-node.is-fading { opacity: 0; transform: translateY(10px); }

.toast-indicator-pill { 
    position: absolute; 
    left: 0; top: 0; bottom: 0; width: 4px; 
    background-color: var(--advitum-accent); 
    border-top-left-radius: 10px; border-bottom-left-radius: 10px; 
}

.toast-icon-check { color: var(--advitum-accent); font-size: 1.1rem; }
.toast-message-body { 
    font-family: var(--advitum-font-main); 
    font-size: 0.82rem; 
    font-weight: 600; 
    color: var(--advitum-white); 
}

/* ==========================================================================
   6. Fluid Responsive Breakpoints
   ========================================================================== */
@media (max-width: 992px) { 
    .advitum-contact-section { padding: 60px 20px; }
    .contact-main-grid { grid-template-columns: 1fr; gap: 44px; } 
    .contact-main-title { font-size: 1.85rem; text-align: center; }
    .contact-intro-text { text-align: center; }
    .contact-mini-badge { align-self: center; }
}

@media (max-width: 576px) { 
