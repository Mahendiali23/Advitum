    .btn-blog-container .btn-action {
        width: 100%;
        padding: 12px;
        border-radius: var(--radius-md);
    }

    .footer-matrix-pipeline {
        grid-template-columns: 1fr 1fr;
        gap: 48px;
    }
}

/* --- Mobile Viewports (600px Breakpoint) --- */
@media (max-width: 600px) {
    .footer-matrix-pipeline {
