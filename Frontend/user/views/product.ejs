    <style>
/* ==========================================================================
   1. ENTERPRISE DESIGN SYSTEM VARIABLES & CORE RESET
   ========================================================================== */
:root {
    --primary: #044E4A;
    --primary-light: #0B6B65;
    --primary-dark: #022F2D;
    --accent: #10B981;
    --accent-light: #E6FDF5;
    --dark: #0F172A;
    --text: #334155;
    --text-muted: #64748B;
    --bg-light: #F8FAFC;
    --bg-glass: rgba(255, 255, 255, 0.85);
    --white: #FFFFFF;
    --border: rgba(226, 232, 240, 0.8);
    
    --font-main: 'Plus Jakarta Sans', sans-serif;
    --font-heading: 'Poppins', sans-serif;
    
    --shadow-sm: 0 4px 6px -1px rgba(4, 78, 74, 0.03);
    --shadow-md: 0 16px 36px -4px rgba(4, 78, 74, 0.06);
    --shadow-lg: 0 24px 60px -12px rgba(4, 78, 74, 0.12);
    
    --radius-pill: 100px;
    --radius-lg: 16px;
    --radius-md: 10px;
    --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
}

html { 
    scroll-behavior: smooth; 
    height: 100%;
}

body { 
    font-family: var(--font-main); 
    color: var(--text); 
    background-color: var(--bg-light); 
    line-height: 1.6; 
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4 { 
    font-family: var(--font-heading); 
    color: var(--dark); 
    letter-spacing: -0.02em;
    line-height: 1.25;
}

a { 
    text-decoration: none; 
    color: inherit; 
    transition: var(--transition); 
}

main {
    flex: 1 0 auto;
    padding-top: 80px;
}

.wrapper { 
    max-width: 1280px; 
    margin: 0 auto; 
    padding: 0 24px; 
    width: 100%; 
}

/* --- Premium Action Controls --- */
.btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    font-weight: 600;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    cursor: pointer;
    border: none;
    transition: var(--transition);
    gap: 8px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    letter-spacing: 0.3px;
}

.btn-action.primary {
    background-color: var(--primary);
    color: var(--white);
    box-shadow: 0 4px 14px rgba(4, 78, 74, 0.18);
}

.btn-action.primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(90deg, var(--primary-light), var(--primary-dark));
    z-index: -1;
    opacity: 0;
    transition: var(--transition);
}

.btn-action.primary:hover::before {
    opacity: 1;
}

.btn-action.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(4, 78, 74, 0.28);
}

/* ==========================================================================
   2. BRAND ARCHITECTURE LOGO
   ========================================================================== */
.brand-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    min-width: 0;
    flex-shrink: 0;
}

.creative-logo {
    position: relative;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: transparent;
}

.brand-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    image-rendering: -webkit-optimize-contrast;
}

.brand-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.brand-meta h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    letter-spacing: -0.03em;
}

.brand-meta span {
    font-size: 0.58rem;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    display: block;
    margin-top: 4px;
    line-height: 1;
}

/* ==========================================================================
   3. FLOATING NAVIGATION ARCHITECTURE
   ========================================================================== */
.nav-anchor {
    position: fixed;
    top: 0; 
    left: 0;
    width: 100%;
    height: 80px; 
    z-index: 1000;
    padding: 0 32px;
    background-color: white;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: height 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    align-items: center;
}

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px; 
    margin: 0 auto;
}

.nav-linkset {
    display: flex;
    align-items: center;
    gap: 4px; 
    list-style: none;
}

.nav-item {
    position: relative;
}

.nav-link-item {
    font-size: 0.86rem; 
    font-weight: 600;   
    color: var(--text-muted);      
    padding: 8px 16px; 
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    position: relative;
    letter-spacing: -0.01em;
}

.nav-link-item:hover {
    color: var(--primary);
    background-color: rgba(4, 78, 74, 0.04);
}

.nav-link-item.active {
    color: var(--primary);
    background-color: var(--accent-light);
    font-weight: 700;
}

.dropdown-card {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px); 
    min-width: 240px; 
    border-radius: var(--radius-lg);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    list-style: none;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(16px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1010;
}

.nav-item:hover .dropdown-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(4px);
}

.dropdown-node a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px; 
    font-size: 0.84rem; 
    font-weight: 500;
    color: var(--text);
    border-radius: var(--radius-md);
    transition: var(--transition);
}

.dropdown-node a:hover {
    background-color: var(--accent-light);
    color: var(--primary-light);
    padding-left: 18px;
}

.mobile-hamburger {
    display: none;
    font-size: 1.4rem; 
    cursor: pointer;
    color: var(--dark);
    background: transparent;
    border: none;
    padding: 4px;
}

/* ==========================================================================
   4. CATALOG & PRODUCT DISPLAY LAYOUT (EXACT REFERENCE DESIGN)
   ========================================================================== */
.catalog-container { 
    height: 85vh; 
    width: 100%; 
    max-width: 1440px;
    margin: 100px auto 20px auto; 
    padding: 0 20px; 
    display: flex; 
    flex-direction: column; 
    overflow: hidden; 
    box-sizing: border-box;
}

.cat-nav-container { 
    display: flex; 
    gap: 10px; 
    margin-bottom: 15px; 
    overflow-x: auto; 
    padding-bottom: 8px; 
    flex-shrink: 0;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f1f5f9;
}

.nav-btn { 
    padding: 8px 20px; border-radius: 8px; border: 1px solid #e2e8f0; 
    cursor: pointer; background: #fff; font-size: 0.88rem; font-weight: 500;
    color: #64748b; transition: all 0.2s; white-space: nowrap; 
}
.nav-btn:hover { border-color: #044E4A; color: #044E4A; }
.nav-btn.active { background: #044E4A; color: #fff; border-color: #044E4A; }

.workspace-layout { 
    display: grid; 
    grid-template-columns: 300px 1fr; 
    gap: 20px; 
    flex: 1; 
    overflow: hidden; 
}

/* Sidebar List */
.sidebar-list { 
    border: 1px solid #e2e8f0; 
    border-radius: 12px; 
    background: #fff; 
    display: flex; 
    flex-direction: column; 
    overflow: hidden;
}

.search-box { padding: 12px; border-bottom: 1px solid #f1f5f9; flex-shrink: 0; }
.search-box input { 
    width: 100%; padding: 10px 14px; border: 1px solid #e2e8f0; 
    border-radius: 8px; font-size: 0.9rem; outline: none;
}
.search-box input:focus { border-color: #044E4A; }

.items-list { 
    list-style: none; overflow-y: auto; flex: 1; 
}
.list-item { 
    padding: 14px 18px; border-bottom: 1px solid #f1f5f9; 
    cursor: pointer; font-size: 0.9rem; transition: 0.2s;
    color: #334155; border-left: 4px solid transparent; font-weight: 500;
}
.list-item:hover { background: #f0fdf4; color: #044E4A; }
.list-item.active { background: #e6fdf5; color: #044E4A; font-weight: 700; border-left: 4px solid #044E4A; }

/* Product Display Panel */
.display-panel { 
    border: 1px solid #e2e8f0; 
    border-radius: 12px; 
    padding: 24px; 
    background: #fff; 
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}

/* Header Action Row inside Detail View */
.panel-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 20px;
    border-bottom: 1px solid #f1f5f9;
}

.breadcrumb-trail {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 500;
}

.breadcrumb-trail span {
    color: #0f172a;
    font-weight: 700;
}

.top-bar-actions {
    display: flex;
    gap: 10px;
}

.btn-share {
    background: #fff;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-share:hover { background: #f8fafc; }

.btn-enquire {
    background: #2dd4bf;
    color: #022f2d;
    border: none;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-enquire:hover { background: #14b8a6; color: #fff; }

/* Split Container: Left Info, Right Media */
.panel-content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 30px;
    align-items: start;
}

.product-detail-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.product-title-main {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}

.market-name-tag {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 600;
}

.detail-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 10px;
    margin-bottom: 4px;
}

.detail-section-body {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.6;
}

.product-detail-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.main-image-box {
    width: 100%;
    height: 260px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.main-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.gallery-thumbnails {
    display: flex;
    gap: 8px;
    overflow-x: auto;
}

.thumb-item {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
}

.thumb-item.active {
    border: 2px solid #0d6e69;
}

.thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* ==========================================================================
   5. FOOTER ARCHITECTURE
   ========================================================================== */
.footer-architecture {
    background-color: #020C0B;
    color: #8A9AAD;
    padding: 100px 0 40px;
    font-size: 0.9rem;
    border-top: 1px solid rgba(16, 185, 129, 0.15);
    position: relative;
    flex-shrink: 0; 
}

.footer-matrix-pipeline {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 1fr;
    gap: 64px;
    margin-bottom: 80px;
}

.footer-anchor-identity h3 {
    color: var(--white);
    font-size: 1.6rem;
    margin-bottom: 20px;
    font-weight: 800;
}

.footer-anchor-identity p {
    line-height: 1.7;
    color: #9494A1;
}

.footer-social-channels {
    display: flex;
    gap: 14px;
    margin-top: 30px;
}

.footer-social-channels a {
    width: 42px;
    height: 42px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9494A1;
    font-size: 1.1rem;
}

.footer-link-group h4 {
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 28px;
    font-weight: 700;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.footer-link-group h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 24px;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
}

.footer-link-group ul {
    list-style: none;
}

.footer-link-group ul li {
    margin-bottom: 14px;
}

.footer-address-nodes li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 20px !important;
}

.footer-address-nodes li i {
    color: var(--accent);
    font-size: 1rem;
    background: rgba(16, 185, 129, 0.06);
    padding: 10px;
    border-radius: var(--radius-md);
}

.footer-signature-row {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.85rem;
    color: #61616A;
}

/* Responsiveness */
@media (max-width: 991px) {
    .workspace-layout { grid-template-columns: 1fr; }
    .panel-content-grid { grid-template-columns: 1fr; }
    .catalog-container { height: auto; }
    .footer-matrix-pipeline { grid-template-columns: 1fr 1fr; gap: 40px; }
}

@media (max-width: 600px) {
    .footer-matrix-pipeline { grid-template-columns: 1fr; }
}


