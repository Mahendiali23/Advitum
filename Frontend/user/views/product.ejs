    .nav-linkset {
        position: fixed;
        top: 72px;
        left: 0;
        width: 100%;
        height: calc(100vh - 72px);
        background: #021715; 
        flex-direction: column;
        align-items: stretch;
        padding: 32px 24px;
        gap: 12px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s;
        z-index: 999;
        box-shadow: var(--shadow-lg);
    }

    .nav-linkset::before {
        content: 'DISTRIBUTION DIRECTORY';
        display: block;
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        color: rgba(16, 185, 129, 0.6);
        font-weight: 700;
        margin-bottom: 4px;
        padding-left: 12px;
    }

    /* Drawer Visibility Modifier State */
    .nav-anchor.open-viewport .nav-linkset {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .nav-actions-wrapper {
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        gap: 12px;
        margin-top: 16px;
    }

    .lang-switcher {
        color: rgba(255, 255, 255, 0.8);
        justify-content: center;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 12px;
        border-radius: var(--radius-md);
    }

    .btn-contact {
        width: 100%;
        padding: 12px;
        border-radius: var(--radius-md);
    }

    /* Drawer Item Typography Real Estate Overrides */
    .nav-link-item {
        width: 100%;
        color: rgba(255, 255, 255, 0.75);
        padding: 12px 18px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-md);
        justify-content: space-between;
        font-size: 0.9rem;
    }

    .nav-link-item:hover,
    .nav-link-item.active,
    .nav-item.mobile-active .nav-link-item {
        color: var(--white);
        background-color: rgba(16, 185, 129, 0.15);
        border-color: rgba(16, 185, 129, 0.3);
    }

    .nav-link-item i {
        color: rgba(255, 255, 255, 0.4);
    }

    .nav-item.mobile-active .nav-link-item i {
        transform: rotate(180deg);
        color: var(--accent);
    }

    /* Mobile Accordion Dropdowns */
    .dropdown-card {
        position: static;
        transform: none !important;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        background: rgba(0, 0, 0, 0.2);
        box-shadow: none;
        border: none;
        padding: 4px;
        display: none;
        border-left: 2px solid var(--accent);
        border-radius: 0 0 var(--radius-md) var(--radius-md);
        width: 100%;
        margin-top: -4px;
    }

    .nav-item.mobile-active .dropdown-card {
        display: block;
    }

    .dropdown-node a {
        color: rgba(255, 255, 255, 0.65);
        padding: 10px 16px;
        font-size: 0.84rem;
    }

    .dropdown-node a:hover {
        background: transparent;
        color: var(--white);
        padding-left: 20px;
    }

    /* Open Navigation Header Override Theme */
    .nav-anchor.open-viewport {
        background-color: #021715 !important;
        border-color: rgba(255, 255, 255, 0.05);
    }
    
    .nav-anchor.open-viewport .brand-meta h2,
    .nav-anchor.open-viewport .mobile-hamburger { 
        color: var(--white); 
    }
    
    .btn-blog-container {
