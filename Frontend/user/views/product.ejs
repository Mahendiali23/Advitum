    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const items = JSON.parse(document.getElementById('data-store').textContent);
        const itemsContainer = document.getElementById('itemsContainer');
        const displayPanel = document.getElementById('displayPanel');
        const searchInput = document.getElementById('searchInput');
        const navBtns = document.querySelectorAll('.nav-btn');

        let activeCategory = 'all';
        let selectedItemId = null;

        // Render Sidebar List
        function updateList() {
            const filtered = items.filter(item => {
                const matchCat = (activeCategory === 'all' || (item.category && item.category._id === activeCategory));
                const matchSearch = item.name.toLowerCase().includes(searchInput.value.toLowerCase());
                return matchCat && matchSearch;
            });

            if (filtered.length > 0) {
                itemsContainer.innerHTML = filtered.map(item => `
                    <li class="list-item ${selectedItemId === item._id ? 'active' : ''}" onclick="showDetail('${item._id}')">
                        ${item.name}
                    </li>
                `).join('');

                // Auto-select first item if none selected or selected item is filtered out
                const exists = filtered.some(i => i._id === selectedItemId);
                if (!selectedItemId || !exists) {
                    showDetail(filtered[0]._id);
                }
            } else {
                itemsContainer.innerHTML = '<li style="padding:20px; color:#64748b;">No products found.</li>';
                displayPanel.innerHTML = '<div style="display:flex; align-items:center; justify-content:center; height:100%; color:#64748b;"><h3>No product selected</h3></div>';
            }
        }

        // Show Product Details Dynamic Handling
        window.showDetail = function(id) {
            selectedItemId = id;
            const product = items.find(i => i._id === id);
            if (!product) return;

            // Update Active class in Sidebar
            document.querySelectorAll('.list-item').forEach(el => el.classList.remove('active'));
            const currentSelectedLi = Array.from(document.querySelectorAll('.list-item'))
                .find(el => el.getAttribute('onclick')?.includes(id));
            if (currentSelectedLi) currentSelectedLi.classList.add('active');

            const catName = product.category ? product.category.name : 'General';
            
            // Image handling (Supports up to 3 images from DB array)
            const fallbackImg = 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=600&q=80';
            let imageList = [];
            if (product.images && Array.isArray(product.images) && product.images.length > 0) {
                imageList = product.images.filter(img => img && img.trim() !== '');
            } else if (product.image) {
                imageList = [product.image];
            }

            if (imageList.length === 0) {
                imageList = [fallbackImg];
            }

            const mainImg = imageList[0];

            // Render 3 Gallery Thumbnails Dynamically
            const thumbnailsHTML = imageList.map((img, index) => `
                <div class="thumb-item ${index === 0 ? 'active' : ''}">
                    <img src="${img}" alt="${product.name} - ${index + 1}" onclick="changeImg('${img}', this)" onerror="this.src='${fallbackImg}'; this.onerror=null;">
                </div>
            `).join('');

            displayPanel.innerHTML = `
                <!-- Top Action Header -->
                <div class="panel-top-bar">
                    <div class="breadcrumb-trail">
                        Pharmaceuticals / ${catName} / <span>${product.name}</span>
                    </div>
                    <div class="top-bar-actions">
                        <button class="btn-share" onclick="copyShareLink()"><i class="fa-solid fa-share-nodes"></i> Share</button>
                        <button class="btn-enquire" onclick="window.location.href='/contact'"><i class="fa-regular fa-comment-dots"></i> Enquire</button>
                    </div>
                </div>

                <!-- Product Grid (Left Content + Right Image) -->
                <div class="panel-content-grid">
                    
                    <!-- Left: Dynamic Details -->
                    <div class="product-detail-left">
                        <h2 class="product-title-main">${product.name}</h2>
                        
                        ${product.marketName ? `<div class="market-name-tag">Market Name: ${product.marketName}</div>` : ''}

                        <div>
                            <div class="detail-section-title">Description</div>
                            <div class="detail-section-body">${product.description || 'No description provided.'}</div>
                        </div>

                        ${product.dosage ? `
                        <div>
                            <div class="detail-section-title">Dosage</div>
                            <div class="detail-section-body">${product.dosage}</div>
                        </div>` : ''}

                        ${product.dosageForm ? `
                        <div>
                            <div class="detail-section-title">Dosage Form</div>
                            <div class="detail-section-body">${product.dosageForm}</div>
                        </div>` : ''}

                        ${product.therapeuticClass ? `
                        <div>
                            <div class="detail-section-title">Therapeutic Class</div>
                            <div class="detail-section-body">${product.therapeuticClass}</div>
                        </div>` : ''}
                    </div>

                    <!-- Right: Dynamic 3 Image Gallery -->
                    <div class="product-detail-right">
                        <div class="main-image-box">
                            <img id="mainDisplayImg" src="${mainImg}" alt="${product.name}" onerror="this.src='${fallbackImg}'; this.onerror=null;">
                        </div>

                        <div class="gallery-thumbnails">
                            ${thumbnailsHTML}
                        </div>
                    </div>

                </div>
            `;
        };

        // Thumbnail Click Switch Function
        window.changeImg = function(src, el) {
            const mainImg = document.getElementById('mainDisplayImg');
            if (mainImg) mainImg.src = src;
            
            document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
            if (el && el.parentElement) {
                el.parentElement.classList.add('active');
            }
        };

        // Share Feature Helper
        window.copyShareLink = function() {
            navigator.clipboard.writeText(window.location.href);
            alert('Product link copied to clipboard!');
        };

        // Event Listeners for Category Navigation
        navBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                navBtns.forEach(b => b.classList.remove('active'));
                e.currentTarget.classList.add('active');
                activeCategory = e.currentTarget.getAttribute('data-id');
                selectedItemId = null;
                updateList();
            });
        });

        // Search Input Listener
        searchInput.addEventListener('input', updateList);

        // Initial Dynamic Load
        updateList();
    });

      document.addEventListener("DOMContentLoaded", () => {
            const mainNavbar = document.querySelector('.nav-anchor');
            const menuToggle = document.querySelector('#menuToggle');
            const navLinkItems = document.querySelectorAll('.nav-link-item');

            // 1. Scroll State Matrix Watcher
            const syncScrollState = () => {
                if (window.scrollY > 20) {
                    mainNavbar.classList.add('scrolled');
                } else {
                    mainNavbar.classList.remove('scrolled');
                }
            };
            window.addEventListener('scroll', syncScrollState, { passive: true });
            syncScrollState();

            // 2. Mobile Dashboard Drawer Viewport Control
            if (menuToggle && mainNavbar) {
                menuToggle.addEventListener('click', (e) => {
                    e.preventDefault();
                    mainNavbar.classList.toggle('open-viewport');
                    
                    if (mainNavbar.classList.contains('open-viewport')) {
                        document.body.style.overflow = 'hidden';
                        menuToggle.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    } else {
                        document.body.style.overflow = '';
                        menuToggle.innerHTML = '<i class="fa-solid fa-bars-staggered"></i>';
                    }
                });
            }

            // 3. Mobile Sub-link Accordion Engine
            navLinkItems.forEach(item => {
                item.addEventListener('click', (e) => {
                    if (window.innerWidth <= 991) {
                        const hasDropdown = item.parentElement.querySelector('.dropdown-card');
                        if (hasDropdown) {
                            e.preventDefault();
                            const activeNode = item.parentElement;
                            
                            document.querySelectorAll('.nav-item').forEach(node => {
                                if(node !== activeNode) node.classList.remove('mobile-active');
                            });

                            activeNode.classList.toggle('mobile-active');
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>
