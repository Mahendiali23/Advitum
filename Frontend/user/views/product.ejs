    color: var(--primary);
}

.nav-item:hover .nav-link-item i {
    transform: rotate(180deg);
}

.nav-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
}

.lang-switcher {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--radius-md);
}

.lang-switcher:hover {
    color: var(--primary);
    background-color: rgba(4, 78, 74, 0.04);
}

.btn-contact {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--white);
    background-color: var(--primary); 
    padding: 10px 20px;
    border-radius: var(--radius-pill); 
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(4, 78, 74, 0.12);
}

.btn-contact:hover {
    background-color: var(--primary-light); 
    box-shadow: 0 6px 18px rgba(4, 78, 74, 0.2);
    transform: translateY(-1px);
}

/* Premium Desktop Hover Dropdowns */
.dropdown-card {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px); 
    min-width: 240px; 
    border-radius: var(--radius-lg);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    list-style: none;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(16px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
    z-index: 1010;
}

.nav-item:hover .dropdown-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(4px);
}

.dropdown-node a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px; 
    font-size: 0.84rem; 
    font-weight: 500;
    color: var(--text);
    border-radius: var(--radius-md);
    transition: var(--transition);
}

.dropdown-node a:hover {
    background-color: var(--accent-light);
    color: var(--primary-light);
    padding-left: 18px;
}

.mobile-hamburger {
    display: none;
    font-size: 1.4rem; 
    cursor: pointer;
    color: var(--dark);
    background: transparent;
    border: none;
    padding: 4px;
    transition: transform 0.2s ease;
}

/* ==========================================================================
   4. MODERN FOOTER PIPELINE
   ========================================================================== */
.footer-architecture {
    background-color: #020C0B;
    color: #8A9AAD;
    padding: 100px 0 40px;
    font-size: 0.9rem;
    border-top: 1px solid rgba(16, 185, 129, 0.15);
    position: relative;
    flex-shrink: 0; 
}

.footer-matrix-pipeline {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 1fr;
    gap: 64px;
    margin-bottom: 80px;
}

.footer-anchor-identity h3 {
    color: var(--white);
    font-size: 1.6rem;
    margin-bottom: 20px;
    font-weight: 800;
}

.footer-anchor-identity p {
    line-height: 1.7;
    color: #9494A1;
}

.footer-social-channels {
    display: flex;
    gap: 14px;
    margin-top: 30px;
}

.footer-social-channels a {
    width: 42px;
    height: 42px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9494A1;
    font-size: 1.1rem;
}

.footer-social-channels a:hover {
    background-color: var(--accent);
    color: var(--white);
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
}

.footer-link-group h4 {
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 28px;
    font-weight: 700;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.footer-link-group h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 24px;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
}

.footer-link-group ul {
    list-style: none;
}

.footer-link-group ul li {
    margin-bottom: 14px;
}

.footer-link-group ul li a {
    color: #8A9AAD;
    display: inline-block;
}

.footer-link-group ul li a:hover {
    color: var(--white);
    transform: translateX(4px);
}

.footer-address-nodes li {
