        grid-template-columns: 1fr;
        gap: 24px;
    }
    
    .development-notice-box {
        flex-direction: column; /* Stacked layouts for mobile devices */
        text-align: center;
        padding: 36px 24px;
        gap: 18px;
    }
    
    .notice-status-icon {
        margin: 0 auto;
    }
}

@media (max-width: 480px) {
    .pharma-header h2 {
        font-size: 2rem;
    }
    
