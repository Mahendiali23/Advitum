<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdVitum Healthcare | Global Nutraceuticals</title>
    <link rel="icon" type="image/png" href="/logo.png?v=10">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
 /* ==========================================================================
   1. ENTERPRISE DESIGN SYSTEM VARIABLES & CORE RESET
   ========================================================================== */
:root {
    --primary: #044E4A;
    --primary-light: #0B6B65;
    --primary-dark: #011E1C;
    --accent: #10B981;
    --accent-light: #E6FDF5;
    --dark: #0F172A;
    --text: #334155;
    --text-muted: #64748B;
    --bg-light: #F8FAFC;
    --bg-glass: rgba(255, 255, 255, 0.75);
    --white: #FFFFFF;
    --border: rgba(226, 232, 240, 0.7);
    --border-glow: rgba(16, 185, 129, 0.15);
    
    --font-main: 'Plus Jakarta Sans', sans-serif;
    --font-heading: 'Poppins', sans-serif;
    
    /* Premium Layered Cinematic Micro-Shadows */
    --shadow-sm: 0 2px 8px -1px rgba(4, 78, 74, 0.02), 0 4px 16px -2px rgba(4, 78, 74, 0.02);
    --shadow-md: 0 12px 24px -4px rgba(4, 78, 74, 0.04), 0 24px 48px -8px rgba(4, 78, 74, 0.03);
    --shadow-lg: 0 32px 64px -16px rgba(4, 78, 74, 0.08), 0 16px 32px -8px rgba(4, 78, 74, 0.04);
    
    --radius-pill: 100px;
    --radius-lg: 16px; 
    --radius-md: 10px;
    
    --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
}

html { 
    scroll-behavior: smooth; 
    height: 100%;
}

body { 
    font-family: var(--font-main); 
    color: var(--text); 
    background-color: var(--bg-light); 
    line-height: 1.6; 
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4 { 
    font-family: var(--font-heading); 
    color: var(--dark); 
    letter-spacing: -0.02em;
    line-height: 1.25;
}

a { 
    text-decoration: none; 
    color: inherit; 
    transition: var(--transition); 
}

/* --- Requirements Item 1: Strict Navbar Structural Clearance Layout --- */
main {
    flex: 1 0 auto;
    padding-top: 80px; /* Maps exactly to desktop fixed layout height */
    position: relative;
    z-index: 1; /* Establishes clean sub-navbar stacking layer context */
}

.wrapper { 
    max-width: 1280px; 
    margin: 0 auto; 
    padding: 0 24px; 
    width: 100%; 
}

/* --- Premium Action Controls --- */
.btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    font-weight: 600;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    cursor: pointer;
    border: none;
    transition: var(--transition);
    gap: 8px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    letter-spacing: 0.3px;
}

.btn-action.primary {
    background-color: var(--primary);
    color: var(--white);
    box-shadow: 0 4px 14px rgba(4, 78, 74, 0.18);
}

.btn-action.primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(90deg, var(--primary-light), var(--primary-dark));
    z-index: -1;
    opacity: 0;
    transition: var(--transition);
}

.btn-action.primary:hover::before {
    opacity: 1;
}

.btn-action.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(4, 78, 74, 0.28);
}

/* ==========================================================================
   2. BRAND ARCHITECTURE LOGO
   ========================================================================== */
.brand-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    min-width: 0;
    flex-shrink: 0;
}

.creative-logo {
    position: relative;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: transparent;
}

.brand-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    image-rendering: -webkit-optimize-contrast;
}

.brand-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.brand-meta h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    letter-spacing: -0.03em;
}

.brand-meta span {
    font-size: 0.58rem;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    display: block;
    margin-top: 4px;
    line-height: 1;
}

/* ==========================================================================
   3. FLOATING NAVIGATION ARCHITECTURE (PROTECTED STRUCTURAL LAYER)
   ========================================================================== */
.nav-anchor {
    position: fixed;
    top: 0; 
    left: 0;
    width: 100%;
    height: 80px; 
    z-index: 1000; /* Dominant global alignment context stacking anchor */
    padding: 0 32px;
    background-color: white;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: height 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    align-items: center;
}

.nav-anchor.scrolled {
    height: 68px;
    background-color: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-md);
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
}

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px; 
    margin: 0 auto;
}

.nav-linkset {
    display: flex;
    align-items: center;
    gap: 4px; 
    list-style: none;
}

.nav-item {
    position: relative;
}

/* --- Requirements Item 2 & 5: Downscaled Typographic Scaling & State Micro-Indications --- */
.nav-link-item {
    font-size: 0.86rem; 
    font-weight: 600;   
    color: var(--text-muted);      
    padding: 8px 16px; 
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    position: relative;
    letter-spacing: -0.01em;
}

.nav-link-item i {
    font-size: 0.7rem;
    color: var(--text-muted);
    transition: transform 0.3s ease, color 0.3s ease;
}

/* Hover Layer State */
.nav-link-item:hover {
    color: var(--primary);
    background-color: rgba(4, 78, 74, 0.04);
}

.nav-link-item:hover i {
    color: var(--primary);
}

/* Active State Layer Anchor */
.nav-link-item.active {
    color: var(--primary);
    background-color: var(--accent-light);
    font-weight: 700;
}

.nav-link-item.active i {
    color: var(--primary);
}

.nav-item:hover .nav-link-item i {
    transform: rotate(180deg);
}

.nav-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
}

.lang-switcher {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--radius-md);
}

.lang-switcher:hover {
    color: var(--primary);
    background-color: rgba(4, 78, 74, 0.04);
}

.btn-contact {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--white);
    background-color: var(--primary); 
    padding: 10px 20px;
    border-radius: var(--radius-pill); 
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(4, 78, 74, 0.12);
}

.btn-contact:hover {
    background-color: var(--primary-light); 
    box-shadow: 0 6px 18px rgba(4, 78, 74, 0.2);
    transform: translateY(-1px);
}

.dropdown-card {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px); 
    min-width: 240px; 
    border-radius: var(--radius-lg);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    list-style: none;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(16px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
    z-index: 1010;
}

.nav-item:hover .dropdown-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(4px);
}

.dropdown-node a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px; 
    font-size: 0.84rem; 
    font-weight: 500;
    color: var(--text);
    border-radius: var(--radius-md);
    transition: var(--transition);
}

.dropdown-node a:hover {
    background-color: var(--accent-light);
    color: var(--primary-light);
    padding-left: 18px;
}

.mobile-hamburger {
    display: none;
    font-size: 1.4rem; 
    cursor: pointer;
    color: var(--dark);
    background: transparent;
    border: none;
    padding: 4px;
    transition: transform 0.2s ease;
}

/* ==========================================================================
   4. MODERN FOOTER PIPELINE (PROTECTED STRUCTURAL LAYER)
   ========================================================================== */
.footer-architecture {
    background-color: #020C0B;
    color: #8A9AAD;
    padding: 100px 0 40px;
    font-size: 0.9rem;
    border-top: 1px solid rgba(16, 185, 129, 0.15);
    position: relative;
    flex-shrink: 0; 
}

.footer-matrix-pipeline {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 1fr;
    gap: 64px;
    margin-bottom: 80px;
}

.footer-anchor-identity h3 {
    color: var(--white);
    font-size: 1.6rem;
    margin-bottom: 20px;
    font-weight: 800;
}

.footer-anchor-identity p {
    line-height: 1.7;
    color: #9494A1;
}

.footer-social-channels {
    display: flex;
    gap: 14px;
    margin-top: 30px;
}

.footer-social-channels a {
    width: 42px;
    height: 42px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9494A1;
    font-size: 1.1rem;
}

.footer-social-channels a:hover {
    background-color: var(--accent);
    color: var(--white);
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
}

.footer-link-group h4 {
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 28px;
    font-weight: 700;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.footer-link-group h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 24px;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
}

.footer-link-group ul {
    list-style: none;
}

.footer-link-group ul li {
    margin-bottom: 14px;
}

.footer-link-group ul li a {
    color: #8A9AAD;
    display: inline-block;
}

.footer-link-group ul li a:hover {
    color: var(--white);
    transform: translateX(4px);
}

.footer-address-nodes li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 20px !important;
}

.footer-address-nodes li i {
    color: var(--accent);
    font-size: 1rem;
    background: rgba(16, 185, 129, 0.06);
    padding: 10px;
    border-radius: var(--radius-md);
}

.footer-address-nodes div strong {
    display: block;
    font-size: 0.85rem;
    color: var(--white);
    margin-bottom: 4px;
}

.footer-address-nodes div span, 
.footer-address-nodes div a {
    color: #9494A1;
    line-height: 1.5;
}

.footer-signature-row {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.85rem;
    color: #61616A;
}

.designer-tag-container {
    display: flex;
    align-items: center;
    background-color: rgba(4, 78, 74, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.08);
    border-radius: var(--radius-pill);
    padding: 8px 20px;
}

.designer-tag-container a {
    color: var(--accent);
    font-weight: 600;
    margin-left: 4px;
}

.designer-tag-container a:hover {
    color: var(--white);
}

/* ==========================================================================
   5. ADVITUM BASE SECTION ISOLATION
   ========================================================================== */
.advitum-page-container {
    width: 100%;
    margin-top: 70px;
    background-color: #FDFEFE;
   
    font-family: var(--font-main);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
}

.advitum-page-container *,
.advitum-page-container *::before,
.advitum-page-container *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* ==========================================================================
   6. PREMIUM HERO HEADER ELEMENT (TYPOGRAPHIC OVERHAUL DETAILED SCALING)
   ========================================================================== */
.advitum-hero-header {
    /* Base background fallback matches your corporate variables */
    background: radial-gradient(120% 120% at 50% 0%, var(--primary-light) 0%, var(--primary-dark) 100%);
    color: var(--white);
    padding: 110px 24px 90px; /* Streamlined for corporate breathing room */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

/* Layer 1: High-Resolution Corporate Healthcare & Sourcing Imagery */
.advitum-hero-header::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Clean healthcare/laboratory manufacturing background */
    background-image: url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop');
    background-size: cover;
    background-position: center 35%;
    background-repeat: no-repeat;
    opacity: 0.15; /* Subtle look taaki text and buttons stand out karein */
    mix-blend-mode: overlay; /* Blends beautifuly with your primary gradient colors */
    pointer-events: none;
    z-index: -2;
}

/* Layer 2: Geometric Corporate Dot Matrix (Original Grid Restored) */
.advitum-hero-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.3;
    pointer-events: none;
    z-index: -1;
}

.advitum-hero-header h1 {
    font-family: var(--font-heading);
    font-size: 2.5rem; /* Downscaled from 3.8rem for corporate polish */
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.03em;
    line-height: 1.2;
    background: linear-gradient(180deg, var(--white) 40%, rgba(255, 255, 255, 0.85) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.15); /* Sharper text readability over image */
}

.advitum-hero-header p {
    font-size: 0.95rem; /* Standardized matching Requirement 2 bounds */
    color: #E2E8F0;
    max-width: 580px;
    margin: 0 auto 36px;
    line-height: 1.6;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2); /* Prevents washing out */
}

.advitum-tabs-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 5px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 5;
}

.advitum-tab-btn {
    background: transparent;
    border: none;
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem; 
    letter-spacing: 0.02em;
    padding: 10px 28px;
    cursor: pointer;
    border-radius: var(--radius-pill);
    transition: var(--transition);
    opacity: 0.7;
    display: flex;
    align-items: center;
    justify-content: center;
}

.advitum-tab-btn:hover {
    opacity: 1;
    color: var(--accent);
}

.advitum-tab-btn.is-active {
    background: var(--white);
    color: var(--primary-dark);
    opacity: 1;
    font-weight: 600;
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.1);
}

/* ==========================================================================
   7. CONTENT DISPLAY SWITCHING MECHANICS
   ========================================================================== */
.advitum-tab-panel {
    display: none;
    max-width: 1200px;
    margin: 0 auto;
    padding: 90px 32px;
}

.advitum-tab-panel.is-active {
    display: block;
    animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUpFade {
    from { opacity: 0; transform: translate3d(0, 15px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* ==========================================================================
   8. DYNAMIC LAYOUT BLOCKS & GRID ALIGNMENT HARMONY
   ========================================================================== */
.advitum-content-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 80px;
    align-items: center; /* Enforces strict baseline alignment grid lines */
    margin-bottom: 110px;
}

.advitum-content-grid.reverse-layout {
    grid-template-columns: 0.95fr 1.05fr;
}

.advitum-text-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.advitum-text-block h2 {
    font-family: var(--font-heading);
    font-size: 1.95rem; /* Downscaled for sharp typographic hierarchy */
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-bottom: 20px;
    display: inline-block;
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 70%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.advitum-text-block p {
    font-size: 0.92rem; /* Premium readable body text footprint */
    line-height: 1.55;
    color: #475569;
    margin-bottom: 20px;
    font-weight: 400;
    letter-spacing: -0.005em;
}

.advitum-text-block p:last-of-type {
    margin-bottom: 0;
}

.advitum-text-block p strong {
    color: var(--primary-dark);
    font-weight: 600;
}

/* Premium Box Highlight Framework Integration */
.advitum-styled-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
}

.advitum-styled-list li {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--dark);
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.4;
    transition: var(--transition);
}

.advitum-styled-list li i {
    color: var(--accent);
    font-size: 0.85rem;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    background: var(--accent-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

/* ==========================================================================
   9. INTERACTIVE CARD FRAMEWORKS (BOX ALIGNMENT & LAYERED HIGHLIGHTS)
   ========================================================================== */
.section-headline-block {
    text-align: center;
    margin-bottom: 48px;
}

.section-headline-block h3 {
    font-family: var(--font-heading);
    font-size: 1.75rem; 
    color: var(--primary-dark);
    font-weight: 700;
    letter-spacing: -0.02em;
}

/* --- Requirements Item 3 & 4: Card Micro-Shadow Framework Layout Array --- */
.advitum-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-bottom: 110px;
}

.advitum-feature-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 32px; 
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    transition: var(--transition);
    z-index: 1;
}

.advitum-feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 1.5px;
    background: linear-gradient(135deg, var(--primary-light), var(--accent));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
}

.card-icon-frame {
    width: 44px;
    height: 44px;
    background: var(--bg-light);
    color: var(--primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
