<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | Admin Dashboard</title>
    <link rel="icon" type="image/png" href="/tablogo.png?v=10">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-full flex items-center justify-center p-4 sm:p-8">

    <div class="w-full max-w-3xl bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden">
        
        <!-- Header -->
        <div class="px-6 py-5 sm:px-8 bg-slate-900 text-white flex items-center justify-between">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-xs font-semibold text-teal-400 uppercase tracking-wider">
                    <i class="fa-solid fa-pen-to-square"></i> Inventory Management
                </div>
                <h2 class="font-heading text-xl sm:text-2xl font-bold tracking-tight">
                    Edit Product: <span class="text-teal-300"><%= item.name %></span>
                </h2>
                <p class="text-xs text-slate-400">Update item parameters, pharmaceutical details, and gallery images</p>
            </div>
            <a href="/admin/dashboard" class="text-slate-400 hover:text-white transition-colors">
                <i class="fa-solid fa-xmark text-xl"></i>
            </a>
        </div>

        <!-- Form -->
        <form action="/admin/items/<%= item._id %>/update" method="POST" class="p-6 sm:p-8 space-y-6">
            
            <!-- Section 1: Core Details -->
            <div>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">1. Core Information</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    
                    <div class="space-y-1.5">
                        <label for="name" class="block text-xs font-semibold text-slate-700">Product Brand Name *</label>
                        <input type="text" id="name" name="name" value="<%= item.name %>" required
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all font-medium">
                    </div>

                    <div class="space-y-1.5">
                        <label for="marketName" class="block text-xs font-semibold text-slate-700">Market Name / Generic Name</label>
                        <input type="text" id="marketName" name="marketName" value="<%= item.marketName || '' %>"
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all font-medium">
                    </div>

                    <div class="space-y-1.5">
                        <label for="category" class="block text-xs font-semibold text-slate-700">Category Classification *</label>
                        <select id="category" name="category" required
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all font-medium">
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>" <%= item.category && item.category.toString() === cat._id.toString() ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <label for="price" class="block text-xs font-semibold text-slate-700">Price (INR) *</label>
                            <input type="number" id="price" name="price" step="0.01" min="0" value="<%= item.price %>" required
                                class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all font-mono">
                        </div>
                        <div class="space-y-1.5">
                            <label for="stock" class="block text-xs font-semibold text-slate-700">Stock Qty *</label>
                            <input type="number" id="stock" name="stock" min="0" value="<%= item.stock %>" required
                                class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-3 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all font-mono">
                        </div>
                    </div>

                </div>
            </div>

            <!-- Section 2: Medical Specifications -->
            <div class="pt-4 border-t border-slate-200">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">2. Pharmaceutical Specifications</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    
                    <div class="space-y-1.5">
                        <label for="dosage" class="block text-xs font-semibold text-slate-700">Dosage Strength</label>
                        <input type="text" id="dosage" name="dosage" value="<%= item.dosage || '' %>" placeholder="e.g. 500 mg / 5 ml"
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none">
                    </div>

                    <div class="space-y-1.5">
                        <label for="dosageForm" class="block text-xs font-semibold text-slate-700">Dosage Form</label>
                        <input type="text" id="dosageForm" name="dosageForm" value="<%= item.dosageForm || '' %>" placeholder="e.g. Capsule, Tablet, Syrup"
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none">
                    </div>

                    <div class="space-y-1.5">
                        <label for="therapeuticClass" class="block text-xs font-semibold text-slate-700">Therapeutic Class</label>
                        <input type="text" id="therapeuticClass" name="therapeuticClass" value="<%= item.therapeuticClass || '' %>" placeholder="e.g. Antibiotics"
                            class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none">
                    </div>

                </div>
            </div>

            <!-- Section 3: Image Links -->
            <div class="pt-4 border-t border-slate-200">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">3. Gallery Images (Up to 3 Image URLs)</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <input type="url" name="images" value="<%= (item.images && item.images[0]) || item.image || '' %>" placeholder="Image URL 1 (Main)"
                        class="bg-slate-50 border border-slate-300 focus:border-indigo-600 rounded-xl px-3 py-2 text-xs text-slate-800">
                    <input type="url" name="images" value="<%= (item.images && item.images[1]) || '' %>" placeholder="Image URL 2"
                        class="bg-slate-50 border border-slate-300 focus:border-indigo-600 rounded-xl px-3 py-2 text-xs text-slate-800">
                    <input type="url" name="images" value="<%= (item.images && item.images[2]) || '' %>" placeholder="Image URL 3"
                        class="bg-slate-50 border border-slate-300 focus:border-indigo-600 rounded-xl px-3 py-2 text-xs text-slate-800">
                </div>
            </div>

            <!-- Section 4: Description -->
            <div class="space-y-1.5 pt-2">
                <label for="description" class="block text-xs font-semibold text-slate-700">Detailed Description</label>
                <textarea id="description" name="description" rows="3"
                    class="w-full bg-slate-50 border border-slate-300 focus:border-indigo-600 focus:bg-white rounded-xl p-3 text-xs text-slate-900 focus:outline-none transition-all resize-none"><%= item.description %></textarea>
            </div>

            <!-- Footer Buttons -->
            <div class="pt-4 border-t border-slate-200 flex items-center justify-between gap-4">
                <a href="/admin/dashboard" class="text-xs font-bold text-slate-500 hover:text-slate-800 uppercase tracking-wider">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-6 py-3 rounded-xl shadow-md transition-all">
                    <i class="fa-solid fa-floppy-disk mr-1"></i> Save Changes
                </button>
            </div>

        </form>
    </div>

</body>
</html>