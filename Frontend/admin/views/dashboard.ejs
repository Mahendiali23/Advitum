<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdVitum Healthcare | Management Dashboard</title>
    <link rel="icon" type="image/png" href="/tablogo.png?v=10">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font-Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full bg-slate-50 text-slate-800 antialiased font-sans selection:bg-teal-500 selection:text-white">

    <!-- App Wrapper -->
    <div class="flex h-full w-full overflow-hidden">
        
        <!-- ========================================== -->
        <!-- SIDEBAR CONTAINER                          -->
        <!-- ========================================== -->
        <aside class="w-64 bg-white border-r border-slate-200 flex flex-col justify-between h-full shrink-0 z-20 shadow-sm">
            <div>
                <!-- Primary Branding -->
                <div class="p-5 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 bg-teal-600 flex items-center justify-center rounded-xl text-white shadow-md shadow-teal-600/20">
                            <i class="fa-solid fa-square-h text-xl"></i>
                        </div>
                        <div>
                            <h2 class="font-heading text-lg font-bold text-slate-900 leading-tight">ADVITUM</h2>
                            <p class="text-[11px] font-semibold tracking-wider uppercase text-teal-600">Healthcare Admin</p>
                        </div>
                    </div>
                </div>

                <!-- Navigation Links -->
                <div class="p-4 space-y-6">
                    <div>
                        <p class="px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Main Menu</p>
                        <nav class="space-y-1">
                            <a href="/admin/dashboard" class="flex items-center justify-between px-3 py-2.5 rounded-lg bg-teal-50 border border-teal-100 text-teal-700 font-semibold text-xs transition-all">
                                <span class="flex items-center gap-3">
                                    <i class="fa-solid fa-chart-pie text-sm text-teal-600"></i>
                                    <span>Dashboard Overview</span>
                                </span>
                            </a>
                            <a href="/admin/items/new" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-medium text-xs transition-all">
                                <i class="fa-solid fa-plus text-slate-400"></i>
                                <span>Add New Item</span>
                            </a>
                            <a href="/admin/categories/new" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-medium text-xs transition-all">
                                <i class="fa-solid fa-folder-plus text-slate-400"></i>
                                <span>Add New Category</span>
                            </a>
                        </nav>
                    </div>

                    <div>
                        <p class="px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Quick External Links</p>
                        <nav class="space-y-1">
                            <a href="/home" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-medium text-xs transition-all">
                                <i class="fa-solid fa-arrow-up-right-from-square text-slate-400"></i>
                                <span>Live Website</span>
                            </a>
                            <a href="/admin/logs" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-medium text-xs transition-all">
                                <i class="fa-solid fa-list-check text-slate-400"></i>
                                <span>System Activity Logs</span>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>

            <!-- Profile Info Footer -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold border border-slate-300">
                        <i class="fa-solid fa-user-doctor text-sm"></i>
                    </div>
                    <div class="truncate flex-1">
                        <h4 class="text-xs font-bold text-slate-800 truncate">Administrator</h4>
                        <p class="text-[10px] text-slate-500 truncate">admin@advitum.com</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA                          -->
        <!-- ========================================== -->
        <main class="flex-1 h-full overflow-y-auto bg-slate-50 p-6 lg:p-8 flex flex-col justify-between">
            
            <div>
                <!-- Header Block -->
                <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-6">
                    <div>
                        <h1 class="font-heading text-2xl font-bold text-slate-900">Inventory & Stock Dashboard</h1>
                        <p class="text-xs text-slate-500 mt-1">Manage all products, pricing details, and categories in one place.</p>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <a href="/admin/categories/new" class="inline-flex items-center gap-2 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-2 rounded-lg border border-slate-300 shadow-sm transition-all">
                            <i class="fa-solid fa-folder-plus text-slate-500"></i> New Category
                        </a>
                        <a href="/admin/items/new" class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs px-3.5 py-2 rounded-lg shadow-sm transition-all">
                            <i class="fa-solid fa-plus"></i> Add Item
                        </a>
                    </div>
                </header>

                <!-- Key Metrics Cards -->
                <section class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
                    <!-- Metric Box 1 -->
                    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total Active Items</span>
                            <span class="text-2xl font-bold text-slate-900 font-heading"><%= totalItems %></span>
                        </div>
                        <div class="h-10 w-10 bg-teal-50 border border-teal-100 flex items-center justify-center rounded-lg text-teal-600">
                            <i class="fa-solid fa-boxes-stacked text-base"></i>
                        </div>
                    </div>

                    <!-- Metric Box 2 -->
                    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total Stock Value</span>
                            <span class="text-2xl font-bold text-emerald-600 font-heading">₹<%= totalValue.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                        </div>
                        <div class="h-10 w-10 bg-emerald-50 border border-emerald-100 flex items-center justify-center rounded-lg text-emerald-600">
                            <i class="fa-solid fa-indian-rupee-sign text-base"></i>
                        </div>
                    </div>

                    <!-- Metric Box 3 -->
                    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total Categories</span>
                            <span class="text-2xl font-bold text-slate-900 font-heading"><%= categories.length %></span>
                        </div>
                        <div class="h-10 w-10 bg-indigo-50 border border-indigo-100 flex items-center justify-center rounded-lg text-indigo-600">
                            <i class="fa-solid fa-folder text-base"></i>
                        </div>
                    </div>
                </section>

                <!-- Active Categories List (With Delete Option) -->
                <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm mb-6">
                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
                            <i class="fa-solid fa-tags text-teal-600"></i> Active Product Categories
                        </h3>
                        <span class="text-[11px] text-slate-400">Manage categories directly below</span>
                    </div>

                    <div class="flex flex-wrap gap-2.5">
                        <% if (categories.length === 0) { %>
                            <p class="text-xs text-slate-500 italic py-1"><i class="fa-solid fa-circle-info mr-1"></i>No categories created yet.</p>
                        <% } else { %>
                            <% categories.forEach(cat => { %>
                                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 text-slate-700 border border-slate-200 text-xs font-medium hover:border-slate-300 transition-all">
                                    <span><%= cat.name %></span>
                                    
                                    <!-- Category Delete Form Action -->
                                    <form id="delete-cat-form-<%= cat._id %>" action="/admin/categories/<%= cat._id %>/delete" method="POST" class="inline">
                                        <button 
                                            type="button" 
                                            data-form-id="delete-cat-form-<%= cat._id %>"
                                            data-item-name="Category: <%= cat.name %>"
                                            class="delete-trigger-btn text-slate-400 hover:text-red-600 transition-colors ml-1 p-0.5 rounded"
                                            title="Delete Category"
                                        >
                                            <i class="fa-solid fa-xmark text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </section>

                <!-- Items Data Table -->
                <section class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                    <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-3">
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">Inventory Items Master List</h2>
                        </div>
                        <span class="text-xs font-medium text-slate-500">
                            Total Records: <strong><%= items.length %></strong>
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[700px]">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] font-bold uppercase tracking-wider border-b border-slate-200">
                                    <th class="px-6 py-3">Item Name</th>
                                    <th class="px-6 py-3">Category</th>
                                    <th class="px-6 py-3">Price</th>
                                    <th class="px-6 py-3">Stock Level</th>
                                    <th class="px-6 py-3">Added Date</th>
                                    <th class="px-6 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                <% if (items.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="px-6 py-12 text-center text-slate-500">
                                            <i class="fa-solid fa-box-open text-2xl text-slate-300 block mb-2"></i>
                                            <p class="font-semibold">No items found in the database.</p>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% items.forEach(item => { %>
                                        <tr class="hover:bg-slate-50/80 transition-colors">
                                            <td class="px-6 py-3.5 font-semibold text-slate-800"><%= item.name %></td>
                                            <td class="px-6 py-3.5">
                                                <span class="px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-100 text-slate-600 border border-slate-200">
                                                    <%= item.category ? item.category.name : 'Unassigned' %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-3.5 font-semibold text-slate-700">₹<%= item.price.toFixed(2) %></td>
                                            <td class="px-6 py-3.5">
                                                <% if (item.stock === 0) { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded bg-red-50 text-red-700 text-[11px] font-bold border border-red-200">
                                                        Out of Stock
                                                    </span>
                                                <% } else if (item.stock <= 15) { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded bg-amber-50 text-amber-700 text-[11px] font-bold border border-amber-200">
                                                        Low Stock (<%= item.stock %>)
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-slate-700 font-medium"><%= item.stock %> units</span>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-3.5 text-slate-500">
                                                <%= new Date(item.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                            </td>
                                            <td class="px-6 py-3.5 text-right whitespace-nowrap">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <!-- Edit Item Button -->
                                                    <a href="/admin/items/<%= item._id %>/edit" class="bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 px-2.5 py-1 rounded-md font-semibold text-[11px] transition-all">
                                                        <i class="fa-solid fa-pen text-slate-400 mr-1"></i> Edit
                                                    </a>
                                                    
                                                    <!-- Delete Item Form Action -->
                                                    <form id="delete-form-<%= item._id %>" action="/admin/items/<%= item._id %>/delete" method="POST" class="inline">
                                                        <button 
                                                            type="button" 
                                                            data-form-id="delete-form-<%= item._id %>"
                                                            data-item-name="Item: <%= item.name %>"
                                                            class="delete-trigger-btn bg-red-50 hover:bg-red-600 text-red-600 hover:text-white border border-red-200 hover:border-red-600 px-2.5 py-1 rounded-md font-semibold text-[11px] transition-all"
                                                        >
                                                            <i class="fa-solid fa-trash mr-1"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- Light Footer -->
            <footer class="mt-8 pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
                <p>&copy; 2026 Advitum Healthcare. All rights reserved.</p>
                <p class="font-medium text-slate-400">System Dashboard v2.0</p>
            </footer>
        </main>
    </div>

    <!-- ========================================== -->
    <!-- UNIFIED CONFIRM DELETION MODAL            -->
    <!-- ========================================== -->
    <div id="system-destruct-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm transition-opacity duration-200">
        <div class="bg-white border border-slate-200 rounded-xl w-full max-w-md shadow-xl overflow-hidden">
            <div class="p-6">
                <div class="flex items-start gap-3">
                    <div class="h-10 w-10 rounded-full bg-red-50 border border-red-100 flex items-center justify-center text-red-600 shrink-0">
                        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-heading text-base font-bold text-slate-900">Confirm Deletion</h3>
                        <p class="text-xs text-slate-500 mt-1">Are you sure you want to delete this record? This process cannot be undone.</p>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-slate-50 border border-slate-200 rounded-lg text-center">
                    <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider block">Target Record:</span>
                    <span id="modal-target-label" class="text-xs font-bold text-red-600 block mt-0.5 truncate">--</span>
                </div>

                <div class="mt-6 flex items-center justify-end gap-2">
                    <button type="button" id="modal-abort-trigger" class="px-4 py-2 text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-lg transition-all">
                        Cancel
                    </button>
                    <button type="button" id="modal-confirm-trigger" class="px-4 py-2 text-xs font-semibold bg-red-600 hover:bg-red-700 text-white rounded-lg shadow-sm transition-all">
                        Delete Permanently
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- INTERACTIVE JAVASCRIPT CONTROLLER          -->
    <!-- ========================================== -->
    <script>
        let interceptedFormIdRef = null;

        function triggerSystemModal(formId, entityName) {
            interceptedFormIdRef = formId;
            const targetedTextSlot = document.getElementById('modal-target-label');
            const targetContainerDOM = document.getElementById('system-destruct-modal');
            
            if (targetedTextSlot && targetContainerDOM) {
                targetedTextSlot.textContent = entityName;
                targetContainerDOM.classList.remove('hidden');
            }
        }

        function dismissSystemModal() {
            const targetContainerDOM = document.getElementById('system-destruct-modal');
            if (targetContainerDOM) {
                targetContainerDOM.classList.add('hidden');
            }
            interceptedFormIdRef = null;
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Global click event handler for all delete triggers (Items & Categories)
            document.body.addEventListener('click', (event) => {
                const triggerBtn = event.target.closest('.delete-trigger-btn');
                if (triggerBtn) {
                    event.preventDefault();
                    const formId = triggerBtn.getAttribute('data-form-id');
                    const itemName = triggerBtn.getAttribute('data-item-name');
                    triggerSystemModal(formId, itemName);
                }
            });

            // Abort Modal Trigger
            const abortBtn = document.getElementById('modal-abort-trigger');
            if (abortBtn) {
                abortBtn.addEventListener('click', dismissSystemModal);
            }

            // Confirm & Submit Target Form
            const confirmBtn = document.getElementById('modal-confirm-trigger');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', () => {
                    if (interceptedFormIdRef) {
                        const targetForm = document.getElementById(interceptedFormIdRef);
                        if (targetForm) {
                            targetForm.submit();
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>